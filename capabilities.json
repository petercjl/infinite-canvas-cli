{
  "schema": "infinite-canvas-capabilities",
  "schema_version": "1.0.0",
  "package": "@petercjl/infinite-canvas-cli",
  "version": "0.1.0",
  "input": {
    "required": [
      "canvas_id",
      "prompt",
      "references"
    ],
    "references": "ordered PNG/JPEG/WebP local files or HTTPS URLs"
  },
  "output": {
    "terminal": "local MP4 + saved Frame containing original reference nodes and one video node",
    "fields": [
      "task_id",
      "status",
      "canvas_id",
      "session_id",
      "run_id",
      "frame_id",
      "reference_element_ids",
      "video_element_id",
      "artifacts"
    ]
  },
  "operations": [
    "browser.status",
    "board.inspect",
    "video.generate.native-agent",
    "task.inspect",
    "task.wait",
    "task.resume",
    "task.sync",
    "frame.group-existing"
  ],
  "generationTransport": {
    "kind": "native-browser-ui",
    "newConversationPerLogicalVideo": true,
    "singleTabPerCanvas": true,
    "concurrency": "separate conversations in the same tab; queued UI submissions and canvas writes; parallel remote runs",
    "submission": "click native Send",
    "directGenerationAPI": false,
    "recovery": "saved sessionId/runId; read-only run and history APIs",
    "model": "inherit webpage settings"
  },
  "dependencies": {
    "node": ">=22",
    "browser": "ecommerce-browser, fixed loopback CDP 9223 and current-user ecommerce profile",
    "canvasAPI": "sealseek-media >=0.6.7, public CLI commands",
    "libraries": [
      "playwright-core",
      "image-size"
    ],
    "optional": [
      "ffprobe"
    ]
  },
  "platforms": {
    "codex:macos": "tested: six native Agent video tasks across two boards; one tab per board; downloads, deduplication and Frame readback verified",
    "generic:macos": "spec-compatible, runtime untested",
    "sealseek:macos": "spec-compatible, runtime untested",
    "generic:windows": "runtime unresolved: ecommerce browser launcher required"
  },
  "commandContracts": {
    "video generate": {
      "options": {
        "--canvas": {
          "type": "string"
        },
        "--prompt": {
          "type": "string"
        },
        "--prompt-file": {
          "type": "string"
        },
        "--reference": {
          "type": "string",
          "repeatable": true
        },
        "--output": {
          "type": "string"
        },
        "--request-id": {
          "type": "string"
        },
        "--new": {
          "type": "boolean"
        },
        "--submit": {
          "type": "boolean"
        },
        "--dry-run": {
          "type": "boolean"
        },
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "local-write",
      "externalMutation": "With --submit: import references, send native Agent conversation, import a missing video, group selected elements in a Frame.",
      "paid": "Only native webpage sending may charge credits."
    },
    "task get|wait|resume|sync": {
      "options": {
        "--timeout": {
          "type": "string"
        },
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "local-write",
      "externalMutation": "resume continues original task; sync reapplies existing video archival and grouping; never a second generation."
    },
    "frame group": {
      "options": {
        "--canvas": {
          "type": "string"
        },
        "--elements": {
          "type": "string"
        },
        "--frame-id": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        },
        "--submit": {
          "type": "boolean"
        },
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "local-write",
      "externalMutation": "With --submit: reparent existing nodes and preserve their identities."
    },
    "doctor": {
      "options": {
        "--canvas": {
          "type": "string"
        },
        "--live": {
          "type": "boolean"
        },
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "skill source": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "skill status|install|update": {
      "options": {
        "--agent": {
          "type": "string"
        },
        "--path": {
          "type": "string"
        },
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "local-write"
    },
    "update check|install": {
      "options": {
        "--yes": {
          "type": "boolean"
        },
        "--agent": {
          "type": "string"
        },
        "--path": {
          "type": "string"
        },
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "package-and-skill-update"
    },
    "update auto": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "local-write"
    }
  },
  "automaticUpdates": {
    "enabledByDefault": true,
    "defaultMode": "notify",
    "intervalHours": 24,
    "timeoutMs": 1500,
    "trigger": "ordinary video/frame/doctor/capabilities entry; excludes help/version/skill/task polling",
    "configuration": "private update-policy.json; update auto on|off|status",
    "disable": "INFINITE_CANVAS_AUTO_UPDATE=0",
    "recovery": "offline backoff preserves installation; source checkout updates through Git; explicit install keeps a package backup",
    "installation": "explicit --yes only; no automatic installation"
  },
  "limitations": [
    "No service-side atomic canvas revision check; stop on detected user edits.",
    "Frame grouping first version supports unrotated image/video nodes.",
    "Do not submit another generation after unknown submission."
  ]
}
